# Copy to an untracked .env.chat; never use production credentials here.
MONGODB_URL=mongodb://127.0.0.1:27018/?replicaSet=chat-rs&directConnection=true
MONGODB_DB_NAME=clara_rosa_chat_dev
CHAT_ENABLED=true
CHAT_REDIS_URL=redis://127.0.0.1:6380/0
CHAT_SCANNER_HOST=127.0.0.1
CHAT_SCANNER_PORT=3311
CHAT_WS_ORIGINS=["http://localhost:4201","http://localhost:4203"]
CORS_ORIGINS=["http://localhost:4201","http://localhost:4203"]
EMAIL_BACKEND=console
ENVIRONMENT=development
BOOTSTRAP_ADMIN_ENABLED=true
