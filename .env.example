# --- Environment ---
ENVIRONMENT=development            # "production" disables the console e-mail backend
FRONTEND_URL=http://localhost:4201
CORS_ORIGINS=http://localhost:4201
# Deployed frontend (Vercel), comma-separated, exact origins, no trailing slash:
#   FRONTEND_URL=https://shop.example.com
#   CORS_ORIGINS=https://shop.example.com,https://dev-shop.example.com
# Printoy production (configure on the API project, not the frontend project):
#   FRONTEND_URL=https://www.printoy3d.com
#   CORS_ORIGINS=https://www.printoy3d.com,https://printoy3d.com
# Vercel preview URLs change on every deployment: use a stable alias for dev, or add an origin regex (backend change).

# --- MongoDB ---
MONGODB_URL=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=clara_rosa_store

# Local chat requires the Compose MongoDB replica set to be initialized first.
# MONGODB_URL=mongodb://127.0.0.1:27017/?replicaSet=store-rs&directConnection=true
CHAT_ENABLED=false
CHAT_REDIS_URL=redis://127.0.0.1:6380/0
CHAT_SCANNER_HOST=127.0.0.1
CHAT_SCANNER_PORT=3311
CHAT_WS_ORIGINS=["http://localhost:4201"]

# --- Session (access JWT + rotating refresh tokens) ---
JWT_SECRET_KEY=change-me-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RATE_LIMIT_ENABLED=true

# --- E-mail ---
# console: logs messages (development only). smtp: real delivery.
EMAIL_BACKEND=console
EMAIL_FROM=Printoy 3D <no-reply@printoy.pt>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_MINUTES=60
